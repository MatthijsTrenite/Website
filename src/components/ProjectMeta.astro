---
interface Props {
  client: string;
  year: number;
  category: string[];
  credits?: string[];
}

const { client, year, category, credits } = Astro.props;
---

<aside class="space-y-6 text-sm">
  <div>
    <h3 class="uppercase tracking-widest text-xs text-[var(--color-text-light)] mb-1">Client</h3>
    <p>{client}</p>
  </div>
  <div>
    <h3 class="uppercase tracking-widest text-xs text-[var(--color-text-light)] mb-1">Year</h3>
    <p>{year}</p>
  </div>
  <div>
    <h3 class="uppercase tracking-widest text-xs text-[var(--color-text-light)] mb-2">Work</h3>
    <div class="flex flex-wrap gap-2">
      {category.map((tag) => (
        <span class="px-3 py-1 rounded-full text-xs bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
          {tag}
        </span>
      ))}
    </div>
  </div>
  {credits && credits.length > 0 && (
    <div>
      <h3 class="uppercase tracking-widest text-xs text-[var(--color-text-light)] mb-1">Credits</h3>
      <ul class="space-y-0.5">
        {credits.map((credit) => (
          <li>{credit}</li>
        ))}
      </ul>
    </div>
  )}
</aside>
