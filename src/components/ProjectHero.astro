---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="w-full aspect-[16/7] mt-6 px-6 lg:px-12">
  <div class="w-full h-full rounded-xl overflow-hidden bg-[var(--color-surface)]">
    <img
      src={src}
      alt={alt}
      class="w-full h-full object-cover"
    />
  </div>
</div>
