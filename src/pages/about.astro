---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Matthijs Trenité">
  <section class="px-6 lg:px-12 py-16 max-w-4xl">
    <h1 class="font-['Instrument_Serif'] text-4xl lg:text-5xl mb-8">About</h1>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_300px] gap-12">
      <div class="space-y-6 text-[var(--color-text-light)] leading-relaxed">
        <p>
          I'm Matthijs Trenité, a multidisciplinary designer based in the Netherlands
          with a focus on branding and art direction. I help brands find their visual
          voice through strategic design thinking and bold creative execution.
        </p>
        <p>
          With experience across brand identity, digital design, and art direction,
          I bring ideas to life from concept to final delivery. I believe great design
          starts with understanding — of the brand, the audience, and the story worth telling.
        </p>
      </div>

      <div class="rounded-xl overflow-hidden bg-[var(--color-surface)] aspect-[3/4]">
        <!-- Portrait photo placeholder -->
      </div>
    </div>

    <div class="mt-16">
      <h2 class="font-['Instrument_Serif'] text-2xl mb-6">More about me</h2>
      <ul class="space-y-2 text-[var(--color-text-light)]">
        <li>Based in the Netherlands</li>
        <li>Passionate about cycling, design, and storytelling</li>
        <li>Always looking for the next creative challenge</li>
      </ul>
    </div>
  </section>
</BaseLayout>
